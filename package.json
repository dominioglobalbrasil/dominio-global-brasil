{
  "name": "dominio-global-brasil-mvp",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "Domínio Global: 27 UFs, 171 cidades estratégicas, guerra urbana e contas, PostgreSQL (Supabase) e hospedagem gratuita no Render",
  "scripts": {
    "start": "node server.mjs",
